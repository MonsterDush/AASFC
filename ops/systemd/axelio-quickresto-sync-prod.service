[Unit]
Description=Axelio QuickResto synchronization (production)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/axelio/prod/repo/backend
EnvironmentFile=/var/www/axelio/prod/repo/backend/.env
ExecStart=/var/www/axelio/prod/venv/bin/python -m app.scripts.sync_quickresto
NoNewPrivileges=true
PrivateTmp=true
