<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <script defer src="/telegram-loader.js?v=20260326-tgloader1"></script>
  <link rel="stylesheet" href="/styles.css?v=20260825-i18nmodal2" />
  <link rel="stylesheet" href="/styles/pages/owner-quickresto.css?v=20260911-monthlyqueue1" />
  <script>
    (() => {
      try {
        const requested = new URLSearchParams(location.search).get("lang");
        const stored = localStorage.getItem("axelio.lang");
        const detected = String(requested || stored || navigator.languages?.[0] || navigator.language || "ru").toLowerCase();
        document.documentElement.lang = detected.startsWith("en") ? "en" : "ru";
      } catch {}
    })();
  </script>
  <script type="module" src="/i18n-bootstrap.js?v=20260826-i18n12"></script>
  <script src="/page-loader.js?v=20260823-navfix1"></script>
  <title>Axelio · История импортов QuickResto</title>
</head>
<body class="quickresto-page">
  <div class="container quickresto-shell">
    <div class="topbar">
      <div class="brand">
        <div class="logo"></div>
        <div class="title">
          <b id="title">История импортов QuickResto</b>
          <div class="muted">месячные запуски и ошибки</div>
        </div>
      </div>
      <div class="userpill" data-userpill>…</div>
    </div>

    <main class="quickresto-content">
      <section class="card section-card quickresto-hero">
        <div class="quickresto-hero__layout">
          <div>
            <div class="quickresto-eyebrow">QuickResto</div>
            <b id="venueTitle">Заведение</b>
            <div class="muted small mt-4">Каждый большой импорт разбит на календарные месяцы. Здесь видно, какой месяц завершён, где импорт остановился и какая проблема требует решения.</div>
          </div>
          <button class="btn subtle inline" id="backToQuickResto" type="button" data-nav-button>К настройке интеграции</button>
        </div>
      </section>

      <section class="card section-card">
        <div class="quickresto-history-toolbar">
          <label>
            <span>Статус импорта</span>
            <select id="statusFilter">
              <option value="">Все статусы</option>
              <option value="PENDING">В очереди</option>
              <option value="RUNNING">Выполняется</option>
              <option value="SUCCEEDED">Завершён</option>
              <option value="PARTIAL">Требует внимания</option>
              <option value="FAILED">Остановлен</option>
            </select>
          </label>
          <button class="btn" id="refreshHistory" type="button">Обновить</button>
        </div>
        <div class="muted small mt-8" id="historyHint" aria-live="polite"></div>
      </section>

      <section class="quickresto-history-page" id="historyList" aria-live="polite">
        <div class="card section-card quickresto-empty">Загружаем историю…</div>
      </section>
    </main>
  </div>

  <div id="toast" class="toast"><div class="toast__text"></div></div>
  <div class="nav"><div class="wrap"><div id="nav"></div></div></div>
  <script type="module" src="/owner-quickresto-import-history.js?v=20260911-monthlyqueue1"></script>
</body>
</html>
